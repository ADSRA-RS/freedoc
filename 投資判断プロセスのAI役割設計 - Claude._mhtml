@charset "utf-8";

.phase-btn { display: block; width: 100%; text-align: left; padding: 8px 10=
px; background: var(--color-background-secondary); border: 1px solid var(--=
color-border-tertiary); border-radius: var(--border-radius-md); cursor: poi=
nter; margin-bottom: 6px; transition: border-color 0.15s, background 0.15s;=
 font-family: var(--font-sans); }

.phase-btn:hover { border-color: var(--color-border-primary); background: v=
ar(--color-background-tertiary); }

.phase-btn.active { border-color: var(--accent); background: var(--accent-b=
g); }

.phase-num { font-size: 10px; font-weight: 500; color: var(--accent-text); =
display: block; }

.phase-name { font-size: 12px; color: var(--color-text-primary); font-weigh=
t: 500; line-height: 1.3; }

.sub-card { background: var(--color-background-secondary); border: 1px soli=
d var(--color-border-tertiary); border-radius: var(--border-radius-md); pad=
ding: 12px 14px; margin-bottom: 10px; }

.sub-name { font-size: 13px; font-weight: 500; color: var(--color-text-prim=
ary); margin-bottom: 6px; }

.ai-tag { display: inline-block; font-size: 11px; font-weight: 500; padding=
: 2px 8px; border-radius: 20px; margin-bottom: 6px; background: var(--accen=
t-bg); color: var(--accent-text); border: 1px solid var(--accent-border); }

.ai-role { font-size: 12px; color: var(--color-text-secondary); line-height=
: 1.6; }

.critical-badge { display: inline-block; font-size: 10px; font-weight: 500;=
 padding: 1px 6px; border-radius: 20px; margin-left: 6px; background: rgb(2=
52, 235, 235); color: rgb(163, 45, 45); border: 1px solid rgb(240, 149, 149=
); }

@media (prefers-color-scheme: dark) {
  .critical-badge { background: rgb(80, 19, 19); color: rgb(240, 149, 149);=
 border-color: rgb(121, 31, 31); }
}

.detail-header { font-size: 15px; font-weight: 500; color: var(--color-text=
-primary); margin-bottom: 4px; }

.detail-desc { font-size: 12px; color: var(--color-text-secondary); margin-=
bottom: 12px; line-height: 1.5; }
