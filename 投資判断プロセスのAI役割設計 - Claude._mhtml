: var(--color-border-tertiary); transform: scale(0.98); }

form.elicit { background: var(--color-background-primary, #fff); border: 0.=
5px solid var(--color-border-tertiary, rgba(31, 30, 29, 0.15)); border-radi=
us: 16px; box-shadow: rgba(0, 0, 0, 0.04) 0px 4px 20px 0px; margin: 4px 20p=
x 24px; overflow: hidden; font-family: var(--font-sans, system-ui, sans-ser=
if); font-size: 14px; line-height: 1.4; -webkit-font-smoothing: antialiased=
