98781' stroke-width=3D'1.5' stroke-linecap=3D'round' fill=3D'none'/%3E%3C/s=
vg%3E") 0px 0px / 100% 100% no-repeat; }

html :where(.cds-root), html :where(.cds-root) *, html :where(.cds-root) ::=
before, html :where(.cds-root) ::after { border-color: var(--cds-border); }

