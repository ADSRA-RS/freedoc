roposalIn_1aw5u_1; animation-timeline: auto; animation-range: normal; anima=
tion-delay: calc(var(--i, 0) * 45ms); }

@media (prefers-reduced-motion: reduce) {
  ._row_1aw5u_1 { animation: auto ease 0s 1 normal none running none; }
}

@keyframes _skillProposalIn_1aw5u_1 {=20
  0% { opacity: 0; transform: translateY(4px); }
  100% { opacity: 1; transform: translateY(0px); }
}

