.animate-\[accordion-close_150ms_ease-out\] { animation: 0.15s ease-out 0s =
1 normal none running accordion-close; }

.animate-\[accordion-open_150ms_ease-out\] { animation: 0.15s ease-out 0s 1=
 normal none running accordion-open; }

.animate-\[conway-pulse-glow_2s_ease-in-out_infinite\] { animation: 2s ease=
-in-out 0s infinite normal none running conway-pulse-glow; }

.animate-\[cursor-move_3s_ease-in-out_infinite\] { animation: 3s ease-in-ou=
t 0s infinite normal none running cursor-move; }

.animate-\[fade-in_200ms_ease-out\] { animation: 0.2s ease-out 0s 1 normal =
none running fade-in; }

